{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src/editor",
    "outDir": "dist/editor",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src/editor/**/*.ts"]
}

{
  "name": "clipforge",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.editor.json && node scripts/build-pages.mjs",
    "typecheck": "tsc -p tsconfig.editor.json --noEmit",
    "test": "node scripts/check-pages.mjs && node scripts/test-navigation.mjs && node scripts/test-transcription-queue.mjs && node scripts/test-shorts-semantic.mjs && node scripts/test-shorts-framing.mjs",
    "verify": "npm run typecheck && npm run build && npm run test",
    "test:browser": "node scripts/test-browser.mjs",
    "test:phase1": "node scripts/test-phase1-browser.mjs",
    "bench:phase1": "node scripts/benchmark-performance.mjs",
    "bench:phase2": "node scripts/benchmark-transcription-queue.mjs",
    "test:media": "node scripts/test-highlights-real-media.mjs",
    "test:caption-gallery": "node scripts/test-caption-gallery.mjs",
    "test:mobile-editor": "node scripts/test-mobile-studio-browser.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "playwright": "1.56.1"
  }
}
